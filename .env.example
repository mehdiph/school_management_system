# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
# Required in production (teachlog.config.settings.production refuses to
# start without a real SECRET_KEY and ALLOWED_HOSTS). Not required for local
# development, which falls back to safe defaults.
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Select which settings module to use. Local development normally leaves
# this unset (defaults to teachlog.config.settings.development).
# DJANGO_SETTINGS_MODULE=teachlog.config.settings.production

# PostgreSQL (production only; local development uses SQLite when these are
# left empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Set to True only once Nginx/SSL is configured in front of the app
# (a later deployment phase) — otherwise this will break HTTP-only access.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Let Django serve MEDIA_URL itself when DEBUG is False. For local/container
# testing only, before Nginx exists — must stay False in real production,
# where Nginx serves MEDIA_URL directly from the media volume.
SERVE_MEDIA=False

# Optional: django, django.request log level (default: INFO)
DJANGO_LOG_LEVEL=INFO

# AI integrations used by the `ai` app / report exports (leave blank if unused)
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=


WEB_CONCURRENCY=3